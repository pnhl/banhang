# Local development only. Use a strong, private value in production.
ADMIN_PASSWORD=change-this-admin-password
# Comma-separated verified email addresses that receive the D1-backed admin role.
ADMIN_EMAILS=admin@example.com

# payOS payment channel credentials. Never expose these in browser code.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Optional override. Defaults to https://your-domain/api/payments/payos/webhook.
PAYOS_WEBHOOK_URL=

# Optional. Leave empty until a Google Analytics 4 web stream is available.
GOOGLE_ANALYTICS_ID=
